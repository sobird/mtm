{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "AUTH_SECRET",
    "MERCHANT_DATABASE_URL",
    "CORE_DATABASE_URL",
    "OPS_DATABASE_URL",
    "MERCHANT_TEST_DATABASE_URL",
    "CORE_TEST_DATABASE_URL",
    "OPS_TEST_DATABASE_URL",
    "OPS_AUTH_SECRET",
    "CORE_API_JWT_SECRET",
    "CORE_API_URL",
    "CORE_PUBLIC_URL",
    "UPLOAD_DIR",
    "UPLOAD_MAX_BYTES",
    "AUTH_COOKIE_SECURE"
  ],
  "globalDependencies": ["packages/config/**"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "AUTH_SECRET",
        "MERCHANT_DATABASE_URL",
        "CORE_DATABASE_URL",
        "OPS_DATABASE_URL",
        "OPS_TEST_DATABASE_URL",
        "OPS_AUTH_SECRET",
        "CORE_API_JWT_SECRET",
        "CORE_API_URL",
        "CORE_PUBLIC_URL",
        "UPLOAD_DIR",
        "UPLOAD_MAX_BYTES"
      ]
    },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "lint": {},
    "format": {},
    "format:fix": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "cache": false },
    "db:migrate": { "cache": false },
    "db:seed": { "cache": false },
    "db:reset": { "cache": false }
  }
}
