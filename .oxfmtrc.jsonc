// https://oxc.rs/docs/guide/usage/formatter/config.html
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": { "sortScripts": true },
  "sortImports": { "newlinesBetween": true },
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",

  "ignorePatterns": ["bun.lock", ".next", "dist"],
}
