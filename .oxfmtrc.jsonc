// https://oxc.rs/docs/guide/usage/formatter/config.html
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "sortImports": { "newlinesBetween": true },
  "ignorePatterns": ["bun.lock"],
}
