{
  "name": "mtm",
  "version": "0.1.0",
  "private": true,
  "description": "美团电商商家管理后台",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "smoke": "NODE_ENV=production bun scripts/smoke.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-table": "^8",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.10",
    "jose": "^4.14.4",
    "lodash": "^4.17.21",
    "lucide-react": "^1.66.0",
    "next": "15",
    "next-auth": "^5.0.0-beta.32",
    "numeral": "^2.0.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.14.200",
    "@types/node": "^22",
    "@types/numeral": "^2.0.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,json5,css,less,scss,md,mdx,html,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sqlite3"
  ]
}
