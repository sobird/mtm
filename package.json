{
  "name": "mtm",
  "version": "0.1.0",
  "private": true,
  "description": "开源电商运营后台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "fmt": "oxfmt --config packages/config/oxfmt.jsonc scripts && turbo run format:fix",
    "fmt:check": "oxfmt --check --config packages/config/oxfmt.jsonc scripts && turbo run format",
    "lint": "oxlint -c packages/config/oxlint.jsonc scripts && turbo run lint",
    "prepare": "husky",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix -c packages/config/oxlint.jsonc",
      "oxfmt --write --config packages/config/oxfmt.jsonc"
    ],
    "*.{json,jsonc,json5,css,less,scss,md,mdx,html,yml,yaml}": [
      "oxfmt --write --config packages/config/oxfmt.jsonc"
    ]
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sqlite3"
  ]
}
