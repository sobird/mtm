// https://oxc.rs/docs/guide/usage/linter/config.html
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error",
  },
  "rules": {
    "unicorn/prefer-node-protocol": "error",

    // React 18 uses the automatic JSX runtime, so `React` need not be in scope.
    "react/react-in-jsx-scope": "off",
    // Style and asset imports are side-effect imports in this webpack setup.
    "import/no-unassigned-import": "off",

    // Preserved from the previous ESLint setup: logging is intentional here.
    "no-console": "warn",

    // Rules that did not fail (or did not run) under the previous ESLint setup.
    "eslint/no-unused-vars": "warn",
    "eslint/no-shadow": "warn",
    "eslint/no-underscore-dangle": "off",
    "react/jsx-key": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react/exhaustive-effect-dependencies": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/no-unstable-nested-components": "off",
    "react/immutability": "off",
    "react/set-state-in-effect": "off",
    "react/memo-dependencies": "off",
    "react/use-memo": "off",
    "promise/always-return": "off",
    "promise/no-callback-in-promise": "off",
    "promise/no-multiple-resolved": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-empty-named-blocks": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/no-instanceof-builtins": "off",
    "unicorn/no-array-sort": "off",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
  },
  "env": {
    "browser": true,
    "node": true,
  },
  "ignorePatterns": [],
}
