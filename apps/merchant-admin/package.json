{
  "name": "@mtm/merchant-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "bun --env-file=../../.env x prisma migrate deploy",
    "db:migrate:dev": "bun --env-file=../../.env x prisma migrate dev",
    "db:reset": "bun --env-file=../../.env x prisma migrate reset --force --skip-seed && bun --env-file=../../.env prisma/seed.ts",
    "db:seed": "bun --env-file=../../.env prisma/seed.ts",
    "dev": "node --env-file=../../.env node_modules/next/dist/bin/next dev -p 3000",
    "format": "oxfmt --check --config ../../packages/config/oxfmt.jsonc",
    "format:fix": "oxfmt --config ../../packages/config/oxfmt.jsonc",
    "lint": "oxlint -c ../../packages/config/oxlint.jsonc",
    "postinstall": "prisma generate",
    "smoke": "NODE_ENV=production bun scripts/smoke.ts",
    "start": "node --env-file=../../.env node_modules/next/dist/bin/next start -p 3000",
    "test": "bun --env-file=../../.env x vitest run",
    "test:watch": "bun --env-file=../../.env x vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@hookform/resolvers": "^7.0.1",
    "@mtm/auth": "workspace:*",
    "@mtm/contracts": "workspace:*",
    "@mtm/ui": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.105.3",
    "antd": "^6.6.8",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.10",
    "jose": "^4.14.4",
    "lodash": "^4.17.21",
    "lucide-react": "^1.66.0",
    "next": "15",
    "next-auth": "^5.0.0-beta.32",
    "numeral": "^2.0.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@mtm/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash": "^4.14.200",
    "@types/node": "^22",
    "@types/numeral": "^2.0.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "jsdom": "^30.1.3",
    "prisma": "^6.19.3",
    "typescript": "^5.0.2",
    "vitest": "^5.1.0"
  }
}
